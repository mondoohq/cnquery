option provider = "go.mondoo.com/cnquery/v9/providers/terraform"
option go_package = "go.mondoo.com/mql/v13/providers/terraform/resources"

// Terraform configuration
//
// Examine a directory of Terraform source: every parsed `.tf` and
// `.tf.json` file, the `tfvars` and `tfvars.json` variable values,
// the referenced modules, and the typed lists of provider, data
// source, variable, and output blocks. Use it to write IaC policy
// against the source representation of an infrastructure tree before
// it has been planned or applied.
terraform {
  // Access to individual files including .tf and .tf.json files
  files() []terraform.file
  // The attributes defined in .tfvars and .tfvars.json
  tfvars() dict
  // All referenced Terraform modules
  modules() []terraform.module
  // Raw HCL blocks
  blocks() []terraform.block
  // Provider blocks
  providers() []terraform.block
  // Data sources blocks
  datasources() []terraform.block
  // Variable blocks
  variables() []terraform.block
  // Output blocks
  outputs() []terraform.block
  // Managed resource declarations
  //
  // Iterate every `resource` block as a terraform.resource record,
  // exposing the resource type, name, owning provider, arguments, tags,
  // count / for_each meta-arguments, explicit dependencies, and the
  // references each argument makes to other objects.
  managedResources() []terraform.resource
  // Data source declarations
  //
  // Iterate every `data` block as a terraform.datasource record,
  // exposing the data source type, name, owning provider, arguments,
  // and the references each argument makes to other objects.
  dataResources() []terraform.datasource
  // Input variable declarations
  //
  // Iterate every `variable` block as a terraform.variable record,
  // exposing the declared name, description, type, default value, and
  // the sensitive and nullable flags.
  variableDefinitions() []terraform.variable
  // Output value declarations
  //
  // Iterate every `output` block as a terraform.output record,
  // exposing the name, description, value, sensitive flag, and the
  // references the value makes to other objects.
  outputValues() []terraform.output
  // Provider configurations
  //
  // Iterate every `provider` block as a terraform.provider record,
  // exposing the local provider name, the optional alias, the
  // configuration arguments, and the references they make.
  providerConfigs() []terraform.provider
  // Module calls declared in the configuration
  //
  // Iterate every `module` block as a terraform.module record built from
  // the source HCL — available without `terraform init` — exposing the
  // source, version, source type, input values, and references.
  moduleCalls() []terraform.module
  // Dependency graph of the configuration
  //
  // Examine the configuration as a graph of blocks and the references
  // between them, with helpers to find unreferenced (orphan) resources
  // and to walk dependencies and dependents transitively.
  graph() terraform.graph
}

// Terraform dependency graph
//
// Examine the configuration as a graph: every resource and data source
// is a node, and an argument that references another object is an edge.
// Use `orphans` to find blocks nothing else references and `edges` to
// enumerate the reference relationships.
terraform.graph {
  // Every managed resource and data source block in the configuration
  nodes() []terraform.block
  // Resource and data source blocks that nothing else references
  //
  // The blocks with no dependents — candidates for dead configuration,
  // most usefully data sources whose result is never consumed.
  orphans() []terraform.block
  // Reference relationships between blocks
  //
  // Each edge records the `from` block address, the `to` block address,
  // and the `argument` that creates the dependency.
  edges() []terraform.graph.edge
}

// Edge in the Terraform dependency graph
private terraform.graph.edge @defaults("from to argument") {
  // Address of the block the reference originates from
  from string
  // Address of the block the reference points to
  to string
  // Argument that creates the dependency
  argument string
}

// Terraform resource blocks
//
// Examine every `resource` block declared across the parsed
// configuration. Initialize with `terraform.resources(resource: ...,
// name: ...)` to filter by Terraform resource type and / or
// resource name without iterating manually.
terraform.resources {
  []terraform.block
  init(resource? any, name? any)
}

// Terraform configuration file (.tf or .tf.json file)
private terraform.file @defaults("path") {
  // Path to the Terraform configuration file on disk
  path string
  // All blocks within the file
  blocks() []terraform.block
}

// File position of a Terraform configuration block
//
// Examine the source location of an HCL block: file path, line and
// column numbers, and byte offset. Used to point reviewers at the
// exact location of a flagged block in the original file.
terraform.fileposition {
  // File path to the Terraform configuration file
  path string
  // Line of the block
  line int
  // Column of the block
  column int
  // Size of the file
  byte int
}

// Terraform resource block
private terraform.block @defaults("type labels") {
  // Block type
  type string
  // Labels that identify the block (e.g., resource type and name)
  labels []string
  // Block name label
  nameLabel() string
  // Terraform resource type, e.g. "aws_instance" (mirrors terraform.state.resource.type and terraform.plan.resourceChange.type)
  resourceType() string
  // Terraform resource name, e.g. "web" in `resource "aws_instance" "web"` (mirrors terraform.state.resource.name and terraform.plan.resourceChange.name)
  resourceName() string
  // Block start position
  start terraform.fileposition
  // Block end position
  end terraform.fileposition
  // Block arguments
  arguments() dict
  // Raw block attributes
  attributes() dict
  // Child blocks
  blocks() []terraform.block
  // Related blocks
  related() []terraform.block
  // References made by this block's arguments
  //
  // Examine every reference an argument in this block makes to another
  // object — a variable, local, data source, managed resource, module,
  // or output. Each entry records the argument it came from, the kind
  // of object referenced, the referenced address, and a link to the
  // referenced block when it resolves within the parsed configuration.
  references() []terraform.reference
  // Child blocks grouped by block type
  //
  // Examine nested configuration blocks keyed by their type, so a
  // policy selects a group directly — for example `nestedBlocks["ingress"]`
  // or `nestedBlocks["server_side_encryption_configuration"]` — instead
  // of filtering the flat `blocks` list. Each value is the list of child
  // blocks of that type, since a type may repeat within a block.
  nestedBlocks() map[string][]terraform.block
  // Normalized argument values
  //
  // Examine the same arguments as `arguments`, but with `jsonencode`
  // policy documents and similar function results returned as their
  // decoded object rather than wrapped in a single-element list, so a
  // policy reads `config["policy"]["Statement"]` directly instead of
  // unwrapping with `arguments["policy"].first["Statement"]`.
  config() dict
  // Effective argument values
  //
  // Examine arguments with `var` defaults, `tfvars`, `local` values, and
  // Terraform functions (such as `merge`, `concat`, `format`, and
  // `lookup`) evaluated into the value that will actually be deployed —
  // for example a `var.environment == "prod" ? ... : "t3.micro"` ternary
  // resolves to its concrete result. Arguments whose value depends on a
  // data source or another resource (unknown until apply) fall back to
  // the reference form used by `config`.
  resolved() dict
  // Full configuration as nested data
  //
  // Examine the block as one walkable document: its arguments plus its
  // child blocks, with each child-block type appearing as a key whose
  // value is the list of those blocks' configuration. Lets a policy read
  // `tree["ingress"][0]["cidr_blocks"]` without hopping through separate
  // accessors.
  tree() dict
  // Block snippet
  snippet string
}

// Reference from a Terraform argument to another object
//
// Examine a single dependency edge: the `argument` the reference
// appears in, the `kind` of object referenced (one of var, local,
// data, resource, module, output, each, count, self, path, or
// terraform), the referenced `target` address (for example
// "aws_vpc.main", "var.region", or "data.aws_ami.ubuntu"), and the
// referenced `name`. When the target resolves to a block in the parsed
// configuration, `block` links to it.
private terraform.reference @defaults("argument kind target") {
  // Argument in which the reference appears, e.g. "vpc_id"
  argument string
  // Kind of object referenced
  //
  // One of var, local, data, resource, module, output, provider, each,
  // count, self, path, or terraform.
  kind string
  // Referenced address, e.g. "aws_vpc.main", "var.region", or "data.aws_ami.ubuntu"
  target string
  // Referenced object name, e.g. "main", "region", or "ubuntu"
  name string
  // Referenced block when the target resolves within the parsed configuration
  block() terraform.block
}

// Terraform managed resource
//
// Examine a single `resource` block, selected by its Terraform
// resource `type` and `name` — for example `aws_instance` named `web`
// in `resource "aws_instance" "web"`. Surfaces the owning provider,
// the configuration arguments, the resolved tags, the count and
// for_each meta-arguments, the explicit depends_on targets, the
// references the arguments make to other objects, and the underlying
// HCL block.
terraform.resource @defaults("type name") {
  // Select a managed resource by its type and / or name, e.g.
  // `terraform.resource(type: "aws_s3_bucket", name: "data")`.
  init(type? string, name? string)
  // Underlying HCL block
  block() terraform.block
  // Terraform resource type, e.g. "aws_instance"
  type string
  // Terraform resource name, e.g. "web"
  name string
  // Local name of the owning provider
  //
  // The explicit `provider` meta-argument when set, otherwise the
  // resource type prefix before the first underscore (for example
  // "aws" for "aws_instance").
  providerName() string
  // Provider configuration this resource is bound to
  //
  // Resolves the `provider` configuration block matching this
  // resource's effective provider name and alias. Null when the
  // configuration relies on an implicit default provider with no
  // `provider` block.
  provider() terraform.provider
  // Configuration arguments
  arguments() dict
  // Resolved value of the `tags` argument
  tags() dict
  // The `count` meta-argument
  count() dict
  // The `for_each` meta-argument
  forEach() dict
  // Blocks this resource explicitly depends on via `depends_on`
  //
  // Each entry in `depends_on` is an address pointing at another
  // managed resource, data source, or module in the configuration;
  // this resolves those addresses to their blocks. Addresses that do
  // not resolve within the parsed configuration are surfaced through
  // `references` with the argument `depends_on` instead.
  dependsOn() []terraform.block
  // References made by this resource's arguments
  references() []terraform.reference
  // Blocks elsewhere in the configuration that reference this resource
  //
  // Examine the blocks whose arguments — at any nesting depth — point at
  // this resource. A resource referenced by nothing is dead
  // configuration; `referencedBy.length` measures how many blocks
  // depend on it.
  referencedBy() []terraform.block
  // Child blocks grouped by block type
  //
  // Examine nested configuration blocks keyed by their type — for
  // example `nestedBlocks["ingress"]` or `nestedBlocks["lifecycle"]` —
  // instead of filtering the flat child-block list. Each value is the
  // list of child blocks of that type.
  nestedBlocks() map[string][]terraform.block
  // Normalized argument values
  //
  // Examine the same arguments as `arguments`, but with `jsonencode`
  // policy documents and similar function results returned as their
  // decoded object rather than wrapped in a single-element list, so a
  // policy reads `config["policy"]["Statement"]` directly.
  config() dict
  // Effective argument values
  //
  // Examine arguments with `var` defaults, `tfvars`, `local` values, and
  // Terraform functions evaluated into the value that will actually be
  // deployed. Arguments whose value depends on a data source or another
  // resource fall back to the reference form used by `config`.
  resolved() dict
  // Full configuration as nested data
  //
  // Examine the resource as one walkable document: its arguments plus its
  // child blocks keyed by type, so a policy reads
  // `tree["ingress"][0]["cidr_blocks"]` directly.
  tree() dict
  // Whether the lifecycle block sets `prevent_destroy`
  preventDestroy() bool
  // Whether the lifecycle block sets `create_before_destroy`
  createBeforeDestroy() bool
  // Attribute names listed in the lifecycle `ignore_changes` meta-argument
  //
  // The attributes Terraform will not act on when they drift, or the
  // single entry `all`. Empty when no `ignore_changes` is set.
  ignoreChanges() []string
  // Absolute resource address
  //
  // The fully qualified address including any module path, for example
  // `aws_instance.web` or `module.vpc.aws_subnet.private`.
  address() string
  // Resource mode, always "managed" for this resource
  mode() string
  // Effective attribute values from the active source
  //
  // The single source-independent view of a resource: the resolved
  // configuration on an HCL connection, the planned after-values on a
  // plan, or the recorded values on a state file. A policy written
  // against `values` runs unchanged across all three.
  values() dict
  // Module call this resource belongs to
  //
  // The `module` block that introduced this resource, or null when the
  // resource is declared in the root module.
  module() terraform.module
  // Every resource, data source, and module this resource depends on
  //
  // The transitive closure of references, following the dependency graph
  // outward — not just direct references but everything reachable from
  // them.
  dependencies() []terraform.block
  // Every block that transitively depends on this resource
  //
  // The transitive closure of `referencedBy`: the blast radius of a
  // change to this resource.
  dependents() []terraform.block
}

// Terraform data source
//
// Examine a single `data` block, selected by its data source `type`
// and `name`. Surfaces the owning provider, the configuration
// arguments, the references the arguments make to other objects, and
// the underlying HCL block.
terraform.datasource @defaults("type name") {
  // Select a data source by its type and / or name, e.g.
  // `terraform.datasource(type: "aws_ami", name: "ubuntu")`.
  init(type? string, name? string)
  // Underlying HCL block
  block() terraform.block
  // Data source type, e.g. "aws_ami"
  type string
  // Data source name, e.g. "ubuntu"
  name string
  // Local name of the owning provider
  //
  // The explicit `provider` meta-argument when set, otherwise the data
  // source type prefix before the first underscore (for example "aws"
  // for "aws_ami").
  providerName() string
  // Provider configuration this data source is bound to
  //
  // Resolves the `provider` configuration block matching this data
  // source's effective provider name and alias. Null when the
  // configuration relies on an implicit default provider with no
  // `provider` block.
  provider() terraform.provider
  // Configuration arguments
  arguments() dict
  // References made by this data source's arguments
  references() []terraform.reference
  // Blocks elsewhere in the configuration that reference this data source
  //
  // Examine the blocks whose arguments — at any nesting depth — point at
  // this data source. A data source referenced by nothing is dead
  // configuration.
  referencedBy() []terraform.block
  // Normalized argument values
  //
  // Examine the same arguments as `arguments`, but with `jsonencode`
  // function results returned as their decoded object rather than
  // wrapped in a single-element list.
  config() dict
  // Effective argument values
  //
  // Examine arguments with `var` defaults, `tfvars`, `local` values, and
  // Terraform functions evaluated into the value that will actually be
  // used. Arguments whose value depends on another resource fall back to
  // the reference form used by `config`.
  resolved() dict
  // Absolute data source address, e.g. `data.aws_ami.ubuntu`
  address() string
  // Resource mode, always "data" for this resource
  mode() string
  // Effective attribute values from the active source
  //
  // The resolved configuration on an HCL connection or the recorded
  // values on a state file, as one source-independent view.
  values() dict
  // Module call this data source belongs to, or null in the root module
  module() terraform.module
  // Transitive closure of references this data source depends on
  dependencies() []terraform.block
  // Transitive closure of blocks that depend on this data source
  dependents() []terraform.block
}

// Terraform input variable
//
// Examine a single `variable` block, selected by its `name`. Surfaces
// the description, the declared type expression, the default value,
// the sensitive and nullable flags, and the underlying HCL block.
private terraform.variable @defaults("name") {
  // Underlying HCL block
  block() terraform.block
  // Variable name
  name string
  // Variable description
  description() string
  // Declared type expression, e.g. "string", "list(string)", "map(any)"
  type() string
  // Default value when no value is supplied
  default() dict
  // Whether Terraform redacts the value in CLI output
  sensitive() bool
  // Whether the variable accepts a null value
  nullable() bool
}

// Terraform output value
//
// Examine a single `output` block, selected by its `name`. Surfaces
// the description, the output value, the sensitive flag, the
// references the value makes to other objects, and the underlying HCL
// block.
private terraform.output @defaults("name") {
  // Underlying HCL block
  block() terraform.block
  // Output name
  name string
  // Output description
  description() string
  // Output value
  value() dict
  // Whether Terraform redacts the value in CLI output
  sensitive() bool
  // References made by this output's value
  references() []terraform.reference
}

// Terraform provider configuration
//
// Examine a single `provider` block, selected by its local `name`.
// Surfaces the optional alias, the configuration arguments, the
// references the arguments make to other objects, and the underlying
// HCL block.
private terraform.provider @defaults("name alias") {
  // Underlying HCL block
  block() terraform.block
  // Local provider name, e.g. "aws"
  name string
  // Provider alias when configured, e.g. "west"
  alias() string
  // Version requirement declared for this provider
  //
  // Resolves the `required_providers` entry in the `terraform` settings
  // block that matches this provider's local name, carrying its source
  // address and version constraint. Null when the provider is not
  // listed under `required_providers`.
  requirement() terraform.settings.requiredProvider
  // Configuration arguments
  arguments() dict
  // References made by this provider's arguments
  references() []terraform.reference
}

// Terraform module reference
//
// Examine a referenced module: a unique key identifying the module
// instance, the source it was loaded from (registry, local path,
// Git URL, …), the version constraint, the on-disk directory it was
// expanded into, and the underlying HCL block including its
// configuration arguments.
terraform.module @defaults("key source") {
  // Unique identifier for the module
  key string
  // Source from which the module was loaded
  source string
  // Module version
  version string
  // Path to the directory where the module is stored
  dir string
  // Where the module is loaded from
  //
  // One of local (a `./` or `../` path), registry (a Terraform registry
  // address), git (a Git or GitHub source), http (an archive URL), or
  // empty when the source is not set.
  sourceType() string
  // Input values passed to the module
  //
  // Each input is the variable name it sets, the value passed (resolved
  // in the calling context), and the module variable declaration it
  // binds to. Excludes the meta-arguments source, version, count,
  // for_each, depends_on, and providers.
  inputs() []terraform.module.input
  // References made by the module's input values
  references() []terraform.reference
  // Managed resources declared in this module's source
  //
  // Navigate into the module's own configuration: the `resource` blocks
  // in the module's source directory, as terraform.resource records with
  // values resolved in this module's context (its variable defaults
  // overridden by the call's inputs). Available for local modules and for
  // registry / git modules once `terraform init` has fetched them.
  resources() []terraform.resource
  // Data sources declared in this module's source
  dataSources() []terraform.datasource
  // Input variables declared in this module's source
  variables() []terraform.variable
  // Outputs declared in this module's source
  outputs() []terraform.output
  // Module calls declared within this module's source
  childModules() []terraform.module
  // Source files of this module
  files() []terraform.file

  // Block (including the configuration)
  block() terraform.block
}

// Value passed to a module input
//
// Examine a single module input: the variable `name` it sets, the
// `value` passed (resolved in the calling context, with var and local
// interpolations evaluated), and the module `variable` declaration it
// binds to.
private terraform.module.input @defaults("name") {
  // Variable name this input sets
  name string
  // Value passed, resolved in the calling context
  value() dict
  // Module variable declaration this input binds to, or null if undeclared
  variable() terraform.variable
}

// Terraform settings block
//
// Examine the contents of the `terraform { ... }` settings block: the
// underlying HCL block, the parsed `required_providers` list (each
// with its local name, source address, and version constraint), and
// the configured `backend` block as a dict.
terraform.settings {
  // The terraform { ... } block holding required_providers, backend, and version constraints
  block terraform.block
  // Provider requirements
  requiredProviders []terraform.settings.requiredProvider
  // Backend configuration
  backend dict
}

// Terraform required provider
private terraform.settings.requiredProvider @defaults("name source version") {
  // Local name of the provider (e.g., "aws", "google")
  name string
  // Source address (e.g., "hashicorp/aws")
  source string
  // Version constraint (e.g., "~> 3.74", ">= 4.0")
  version string
}

// Terraform state file
//
// Examine a parsed Terraform state file (`terraform.tfstate` or the
// `terraform show -json` output). Surfaces the state format version,
// the Terraform version that wrote it, the declared output values,
// the root module, a flat list of every module, and a flat list of
// every managed and data resource captured in state.
terraform.state {
  // Terraform state format version
  formatVersion string
  // Generated by Terraform version
  terraformVersion string
  // Output values
  outputs() []terraform.state.output
  // Root module which consists resources defined in .tf files
  rootModule() terraform.state.module
  // Flat list of all modules
  modules() []terraform.state.module
  // A flat list of all resources across all modules
  resources() []terraform.state.resource
}

// Terraform state output value
//
// Examine a single declared output, identified by `identifier`: the
// resolved value, its type definition, and a `sensitive` flag
// indicating whether Terraform should redact the value in CLI output.
terraform.state.output @defaults("identifier") {
  init(identifier string)
  // Output identifier
  identifier string
  // Whether the output is sensitive
  sensitive bool
  // Output value
  value() dict
  // Output value type
  type() dict
}

// Terraform state module
//
// Examine a single module captured in state, identified by its
// absolute module `address`. Iterate `resources()` for the
// infrastructure objects this module owns and `childModules()` to
// walk into nested modules.
terraform.state.module @defaults("address") {
  init(identifier string)
  // Module identifier address
  address string
  // Resources that describe infrastructure objects
  resources() []terraform.state.resource
  // Child modules called from this module
  childModules() []terraform.state.module
}

// Terraform state resource
//
// Examine a single managed or data resource as captured in state:
// absolute address, mode (managed vs data), Terraform resource type
// and name, the responsible provider, the schema version of the
// `values` payload, the attribute values themselves, the dependency
// list, the `tainted` flag, and any `deposedKey`. Use it to write
// policies that match the post-apply shape of infrastructure.
terraform.state.resource @defaults("type name") {
  // Address is the absolute resource address
  address string
  // Resource mode: "managed" (created/updated by Terraform) or "data" (read-only data source)
  mode string
  // Resource type
  type string
  // Resource name
  name string
  // Terraform provider
  providerName string
  // Which version of the resource type schema the `values` property conforms to
  schemaVersion int
  // Attribute values
  values dict
  // List of the resource's dependencies
  dependsOn []string
  // Whether the resource is marked tainted (will be destroyed and recreated on the next apply)
  tainted bool
  // Whether the resource is deposed in the Terraform state
  deposedKey string
}

// Terraform plan file
//
// Examine a parsed Terraform plan (`terraform show -json plan`).
// Surfaces the plan's format version, the Terraform version that
// produced it, the variables used to generate the plan, every
// proposed resource change, and `applyable` / `errored` flags
// indicating whether `terraform apply` is expected to succeed.
terraform.plan {
  // Terraform plan format version
  formatVersion string
  // Generated by Terraform version
  terraformVersion string
  // Resource changes
  resourceChanges() []terraform.plan.resourceChange
  // Variables used to generate the Terraform plan
  variables []terraform.plan.variable
  // Whether `apply` is valid for the plan
  applyable bool
  // Whether the plan errored
  errored bool
}

// Terraform plan configuration
//
// Examine the configuration section of a plan: the per-provider
// configuration entries and the resource configuration belonging to
// the root module — the shape Terraform was about to apply.
terraform.plan.configuration {
  // Provider configuration
  providerConfig() []dict
  // Root module resource configuration
  resources() []dict
}

// Terraform plan variable
//
// Examine a variable supplied to the plan: its name and the resolved
// value (typed as a dict to preserve the original Terraform value
// shape).
terraform.plan.variable @defaults("name value") {
  // Variable name
  name string
  // Variable value
  value dict
}

// Terraform plan resource change
//
// Examine a single proposed change in a plan: the absolute resource
// address, any `previousAddress` (when the resource was moved), the
// owning module address, mode (managed vs data), Terraform resource
// type and name, the responsible provider, a `deposed` marker (set
// when the change applies to a deposed object), the typed
// `proposedChange` describing the actions and before / after values,
// and the human-readable `actionReason`.
terraform.plan.resourceChange @defaults("type name") {
  // Resource address
  address string
  // Resource previous address
  previousAddress string
  // Resource module address
  moduleAddress string
  // Resource mode
  mode string
  // Resource type
  type string
  // Resource name
  name string
  // Provider name
  providerName string
  // Whether the action applies to a deposed object
  deposed string
  // Change to make to this object
  change terraform.plan.proposedChange
  // Resource action reason
  actionReason string
}

// Terraform plan proposed change
//
// Examine the actions Terraform will apply to a resource (create /
// read / update / delete / no-op) along with the before / after
// states, the per-attribute `afterUnknown` map, the
// `beforeSensitive` / `afterSensitive` redaction flags, and the
// `replacePaths` list identifying which attribute changes force a
// replace.
terraform.plan.proposedChange @defaults("actions after") {
  // Resource address
  address string
  // Actions Terraform will apply to the resource (e.g., "create", "read", "update", "delete", "no-op")
  actions []string
  // Resource before values
  before dict
  // Resource after values
  after dict

  afterUnknown dict
  beforeSensitive dict
  afterSensitive dict
  replacePaths dict
}
