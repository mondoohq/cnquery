option provider = "go.mondoo.com/cnquery/v9/providers/terraform"
option go_package = "go.mondoo.com/mql/v13/providers/terraform/resources"

// Terraform configuration
//
// Examine a directory of Terraform source: every parsed `.tf` and
// `.tf.json` file, the `tfvars` and `tfvars.json` variable values,
// the referenced modules, and the typed lists of provider, data
// source, variable, and output blocks. Use it to write IaC policy
// against the source representation of an infrastructure tree before
// it has been planned or applied.
terraform {
  // Access to individual files including .tf and .tf.json files
  files() []terraform.file
  // The attributes defined in .tfvars and .tfvars.json
  tfvars() dict
  // All referenced Terraform modules
  modules() []terraform.module
  // Raw HCL blocks
  blocks() []terraform.block
  // DEPRECATED: use providerDecls instead
  providers() @maturity("deprecated") []terraform.block
  // DEPRECATED: use dataSourceDecls instead
  datasources() @maturity("deprecated") []terraform.block
  // DEPRECATED: use variableDecls instead
  variables() @maturity("deprecated") []terraform.block
  // DEPRECATED: use outputDecls instead
  outputs() @maturity("deprecated") []terraform.block
  // Variable declarations
  //
  // Every `variable "name" { ... }` block declared in the parsed
  // configuration, with each variable's declared type, default value,
  // description, and sensitivity / nullability flags surfaced as typed
  // fields.
  variableDecls() []terraform.variable
  // Local value declarations
  //
  // Every entry across all `locals { ... }` blocks, flattened into one
  // record per local. Each record carries the local's name, value, and
  // a reference to the surrounding `locals` block for source location.
  localDecls() []terraform.local
  // Output declarations
  //
  // Every `output "name" { ... }` block in the parsed configuration,
  // with the declared value expression, description, and sensitive
  // flag surfaced as typed fields.
  outputDecls() []terraform.output
  // Provider configuration blocks
  //
  // Every `provider "name" { ... }` configuration block in the parsed
  // configuration, with alias, legacy version constraint, and the
  // remaining provider configuration arguments surfaced as typed
  // fields.
  providerDecls() []terraform.providerConfig
  // Data source declarations
  //
  // Every `data "type" "name" { ... }` block in the parsed
  // configuration, with the data source type, local name, derived
  // owning provider, and arguments surfaced as typed fields.
  dataSourceDecls() []terraform.dataSource
  // Managed resource declarations
  //
  // Every `resource "type" "name" { ... }` block in the parsed
  // configuration, with the resource type, local name, derived owning
  // provider, configuration arguments, meta-arguments (`count`,
  // `for_each`, `depends_on`), and `lifecycle` sub-block surfaced as
  // typed fields.
  resourceDecls() []terraform.resource
}

// Terraform resource blocks
//
// Examine every `resource` block declared across the parsed
// configuration. Initialize with `terraform.resources(resource: ...,
// name: ...)` to filter by Terraform resource type and / or
// resource name without iterating manually.
terraform.resources {
  []terraform.block
  init(resource? any, name? any)
}

// Terraform configuration file (.tf or .tf.json file)
private terraform.file @defaults("path") {
  // Path to the Terraform configuration file on disk
  path string
  // All blocks within the file
  blocks() []terraform.block
}

// File position of a Terraform configuration block
//
// Examine the source location of an HCL block: file path, line and
// column numbers, and byte offset. Used to point reviewers at the
// exact location of a flagged block in the original file.
terraform.fileposition {
  // File path to the Terraform configuration file
  path string
  // Line of the block
  line int
  // Column of the block
  column int
  // Size of the file
  byte int
}

// Terraform resource block
private terraform.block @defaults("type labels") {
  // Block type
  type string
  // Labels that identify the block (e.g., resource type and name)
  labels []string
  // Block name label
  nameLabel() string
  // Block start position
  start terraform.fileposition
  // Block end position
  end terraform.fileposition
  // Block arguments
  arguments() dict
  // Raw block attributes
  attributes() dict
  // Child blocks
  blocks() []terraform.block
  // Related blocks
  related() []terraform.block
  // Block snippet
  snippet string
}

// Terraform module reference
//
// Examine a referenced module: a unique key identifying the module
// instance, the source it was loaded from (registry, local path,
// Git URL, …), the version constraint, the on-disk directory it was
// expanded into, and the underlying HCL block including its
// configuration arguments.
terraform.module @defaults("key source") {
  // Unique identifier for the module
  key string
  // Source from which the module was loaded
  source string
  // Module version
  version string
  // Path to the directory where the module is stored
  dir string

  // Block (including the configuration)
  block() terraform.block
}

// Terraform settings block
//
// Examine the contents of the `terraform { ... }` settings block: the
// underlying HCL block, the parsed `required_providers` list (each
// with its local name, source address, and version constraint), and
// the configured `backend` block as a dict.
terraform.settings {
  // The terraform { ... } block holding required_providers, backend, and version constraints
  block terraform.block
  // Provider requirements
  requiredProviders []terraform.settings.requiredProvider
  // Backend configuration
  backend dict
}

// Terraform required provider
private terraform.settings.requiredProvider @defaults("name source version") {
  // Local name of the provider (e.g., "aws", "google")
  name string
  // Source address (e.g., "hashicorp/aws")
  source string
  // Version constraint (e.g., "~> 3.74", ">= 4.0")
  version string
}

// Terraform state file
//
// Examine a parsed Terraform state file (`terraform.tfstate` or the
// `terraform show -json` output). Surfaces the state format version,
// the Terraform version that wrote it, the declared output values,
// the root module, a flat list of every module, and a flat list of
// every managed and data resource captured in state.
terraform.state {
  // Terraform state format version
  formatVersion string
  // Generated by Terraform version
  terraformVersion string
  // Output values
  outputs() []terraform.state.output
  // Root module which consists resources defined in .tf files
  rootModule() terraform.state.module
  // Flat list of all modules
  modules() []terraform.state.module
  // A flat list of all resources across all modules
  resources() []terraform.state.resource
}

// Terraform state output value
//
// Examine a single declared output, identified by `identifier`: the
// resolved value, its type definition, and a `sensitive` flag
// indicating whether Terraform should redact the value in CLI output.
terraform.state.output @defaults("identifier") {
  init(identifier string)
  // Output identifier
  identifier string
  // Whether the output is sensitive
  sensitive bool
  // Output value
  value() dict
  // Output value type
  type() dict
}

// Terraform state module
//
// Examine a single module captured in state, identified by its
// absolute module `address`. Iterate `resources()` for the
// infrastructure objects this module owns and `childModules()` to
// walk into nested modules.
terraform.state.module @defaults("address") {
  init(identifier string)
  // Module identifier address
  address string
  // Resources that describe infrastructure objects
  resources() []terraform.state.resource
  // Child modules called from this module
  childModules() []terraform.state.module
}

// Terraform state resource
//
// Examine a single managed or data resource as captured in state:
// absolute address, mode (managed vs data), Terraform resource type
// and name, the responsible provider, the schema version of the
// `values` payload, the attribute values themselves, the dependency
// list, the `tainted` flag, and any `deposedKey`. Use it to write
// policies that match the post-apply shape of infrastructure.
terraform.state.resource @defaults("type name") {
  // Address is the absolute resource address
  address string
  // Resource mode: "managed" (created/updated by Terraform) or "data" (read-only data source)
  mode string
  // Resource type
  type string
  // Resource name
  name string
  // Terraform provider
  providerName string
  // Which version of the resource type schema the `values` property conforms to
  schemaVersion int
  // Attribute values
  values dict
  // List of the resource's dependencies
  dependsOn []string
  // Whether the resource is marked tainted (will be destroyed and recreated on the next apply)
  tainted bool
  // Whether the resource is deposed in the Terraform state
  deposedKey string
}

// Terraform plan file
//
// Examine a parsed Terraform plan (`terraform show -json plan`).
// Surfaces the plan's format version, the Terraform version that
// produced it, the variables used to generate the plan, every
// proposed resource change, and `applyable` / `errored` flags
// indicating whether `terraform apply` is expected to succeed.
terraform.plan {
  // Terraform plan format version
  formatVersion string
  // Generated by Terraform version
  terraformVersion string
  // Resource changes
  resourceChanges() []terraform.plan.resourceChange
  // Variables used to generate the Terraform plan
  variables []terraform.plan.variable
  // Whether `apply` is valid for the plan
  applyable bool
  // Whether the plan errored
  errored bool
}

// Terraform plan configuration
//
// Examine the configuration section of a plan: the per-provider
// configuration entries and the resource configuration belonging to
// the root module — the shape Terraform was about to apply.
terraform.plan.configuration {
  // Provider configuration
  providerConfig() []dict
  // Root module resource configuration
  resources() []dict
}

// Terraform plan variable
//
// Examine a variable supplied to the plan: its name and the resolved
// value (typed as a dict to preserve the original Terraform value
// shape).
terraform.plan.variable @defaults("name value") {
  // Variable name
  name string
  // Variable value
  value dict
}

// Terraform plan resource change
//
// Examine a single proposed change in a plan: the absolute resource
// address, any `previousAddress` (when the resource was moved), the
// owning module address, mode (managed vs data), Terraform resource
// type and name, the responsible provider, a `deposed` marker (set
// when the change applies to a deposed object), the typed
// `proposedChange` describing the actions and before / after values,
// and the human-readable `actionReason`.
terraform.plan.resourceChange @defaults("type name") {
  // Resource address
  address string
  // Resource previous address
  previousAddress string
  // Resource module address
  moduleAddress string
  // Resource mode
  mode string
  // Resource type
  type string
  // Resource name
  name string
  // Provider name
  providerName string
  // Whether the action applies to a deposed object
  deposed string
  // Change to make to this object
  change terraform.plan.proposedChange
  // Resource action reason
  actionReason string
}

// Terraform plan proposed change
//
// Examine the actions Terraform will apply to a resource (create /
// read / update / delete / no-op) along with the before / after
// states, the per-attribute `afterUnknown` map, the
// `beforeSensitive` / `afterSensitive` redaction flags, and the
// `replacePaths` list identifying which attribute changes force a
// replace.
terraform.plan.proposedChange @defaults("actions after") {
  // Resource address
  address string
  // Actions Terraform will apply to the resource (e.g., "create", "read", "update", "delete", "no-op")
  actions []string
  // Resource before values
  before dict
  // Resource after values
  after dict

  afterUnknown dict
  beforeSensitive dict
  afterSensitive dict
  replacePaths dict
}

// Terraform input variable declaration
//
// Examine a single `variable "name" { ... }` block: the variable's
// local name, the raw text of its declared `type` constraint (e.g.
// `string`, `list(string)`, `object({...})`), the `default` value as
// a dict so any Terraform value shape is preserved, the human
// description, and the `sensitive` / `nullable` flags. The underlying
// HCL block is available through `block` for access to source
// location and raw attributes.
private terraform.variable @defaults("name type") {
  // Variable name
  name string
  // Declared type constraint as the raw HCL expression source
  type string
  // Default value, or null if no default is declared
  default() dict
  // Description string
  description() string
  // Whether the variable is marked sensitive
  sensitive() bool
  // Whether the variable may take the null value
  nullable() bool
  // Underlying HCL block
  block terraform.block
}

// Terraform local value declaration
//
// Examine a single named entry inside a `locals { ... }` block. One
// `locals` block can declare many locals, so each attribute becomes
// its own `terraform.local` record. The `block` field points back at
// the enclosing `locals` block for source location and grouping.
private terraform.local @defaults("name") {
  // Local value name (attribute key inside `locals { ... }`)
  name string
  // Local value
  value() dict
  // Enclosing `locals { ... }` HCL block
  block terraform.block
}

// Terraform output declaration
//
// Examine a single `output "name" { ... }` block: the output's local
// name, the declared `value` expression resolved to a dict so any
// Terraform value shape is preserved, the human description, and the
// `sensitive` flag indicating whether Terraform should redact the
// value.
private terraform.output @defaults("name") {
  // Output name
  name string
  // Output value expression
  value() dict
  // Description string
  description() string
  // Whether the output is marked sensitive
  sensitive() bool
  // Underlying HCL block
  block terraform.block
}

// Terraform provider configuration block
//
// Examine a single `provider "name" { ... }` configuration block:
// the provider's local name, the optional `alias` that selects a
// non-default configuration, the legacy `version` constraint when
// present (modern configurations use `required_providers` instead),
// and the remaining provider configuration arguments collected into
// a dict.
private terraform.providerConfig @defaults("name alias") {
  // Provider local name (e.g. "aws", "google")
  name string
  // Provider configuration alias
  //
  // Empty when the block defines the default configuration for this
  // provider.
  alias() string
  // Legacy `version` constraint declared on this block
  //
  // Empty when not set; modern configurations declare version
  // constraints in `terraform { required_providers { ... } }` instead.
  version() string
  // Remaining provider configuration arguments
  //
  // Includes region, profile, assume_role, and any other provider
  // configuration attributes; alias and the legacy version constraint
  // are surfaced as separate fields.
  config() dict
  // Underlying HCL block
  block terraform.block
}

// Terraform data source declaration
//
// Examine a single `data "type" "name" { ... }` block: the data
// source type, the local name, the derived owning provider (the
// substring of the type before the first underscore — `aws` for
// `aws_caller_identity`), and the block's configuration arguments
// collected into a dict.
private terraform.dataSource @defaults("type name") {
  // Data source type (e.g. "aws_caller_identity")
  type string
  // Data source local name
  name string
  // Owning provider derived from the type prefix
  //
  // For example, "aws" for "aws_caller_identity". Empty when the type
  // has no underscore.
  provider() string
  // Data source configuration arguments
  arguments() dict
  // Underlying HCL block
  block terraform.block
}

// Terraform managed resource declaration
//
// Examine a single `resource "type" "name" { ... }` block: the
// resource type, local name, derived owning provider, configuration
// arguments, the `count` / `for_each` meta-argument expressions (or
// null when not used), the static `depends_on` list, and the typed
// `lifecycle` sub-block if one is declared.
private terraform.resource @defaults("type name") {
  // Resource type (e.g. "aws_s3_bucket")
  type string
  // Resource local name
  name string
  // Owning provider derived from the type prefix
  //
  // For example, "aws" for "aws_s3_bucket". Empty when the type has
  // no underscore.
  provider() string
  // Resource configuration arguments
  //
  // The attribute map of the resource body, excluding meta-arguments
  // (`count`, `for_each`, `depends_on`, `provider`) and the
  // `lifecycle` sub-block, which are surfaced as their own fields.
  arguments() dict
  // `count` meta-argument expression, or null when not declared
  count() dict
  // `for_each` meta-argument expression, or null when not declared
  forEach() dict
  // `depends_on` reference list
  //
  // List of reference strings (e.g. "aws_s3_bucket.logs"); empty
  // when not declared.
  dependsOn() []string
  // Typed view of the `lifecycle` sub-block
  //
  // Null when no `lifecycle { ... }` block is declared on this
  // resource.
  lifecycle() terraform.lifecycle
  // Underlying HCL block
  block terraform.block
}

// Terraform resource lifecycle block
//
// Examine the `lifecycle { ... }` sub-block of a resource: the
// `create_before_destroy` / `prevent_destroy` flags, the
// `ignore_changes` attribute list (the literal "all" sentinel is
// preserved as a single-element list), the `replace_triggered_by`
// reference list, and the typed `precondition` / `postcondition`
// custom-condition blocks.
private terraform.lifecycle @defaults("preventDestroy createBeforeDestroy") {
  // Whether `create_before_destroy` is set; false when omitted
  createBeforeDestroy bool
  // Whether `prevent_destroy` is set; false when omitted
  preventDestroy bool
  // Attribute paths listed in `ignore_changes`
  //
  // A bare `all` token is preserved as the single element "all".
  ignoreChanges []string
  // Reference strings listed in `replace_triggered_by`
  //
  // Empty when not declared.
  replaceTriggeredBy []string
  // `precondition` custom-condition blocks
  preconditions() []terraform.condition
  // `postcondition` custom-condition blocks
  postconditions() []terraform.condition
  // Underlying HCL `lifecycle` block
  block terraform.block
}

// Terraform custom-condition block
//
// Examine a single `precondition` or `postcondition` sub-block:
// the raw `condition` expression source, and the
// `error_message` string emitted when the condition does not hold.
private terraform.condition @defaults("errorMessage") {
  // Raw `condition` expression source
  condition string
  // `error_message` value
  errorMessage string
  // Underlying HCL `precondition` / `postcondition` block
  block terraform.block
}
